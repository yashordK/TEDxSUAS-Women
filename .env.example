# Neon Postgres connection string (use the pooled URL from the Neon console)
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Resend API key. Leave empty to log emails to the server console instead of sending.
RESEND_API_KEY=""
# Verified sender for Resend (must be on a domain you've verified in Resend)
EMAIL_FROM="TEDxSUAS Women <hello@example.com>"


# Public URL of the site, no trailing slash
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Organiser dashboard (/admin). Temporary password every new or reset organiser
# signs in with; each person must replace it on first login. Share it privately.
ADMIN_INITIAL_PASSWORD="choose-a-strong-temporary-password"
